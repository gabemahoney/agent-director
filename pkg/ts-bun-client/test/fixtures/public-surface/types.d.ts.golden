     * seen running. Zero is a legitimate result when no row was deleted.
     */
    count: number;
    /**
     * Sorted ids of the rows deleted after tmux showed no session of the agent
     * (Gone) and its recorded process was not seen running, each only while
     * the row was unchanged since expire examined it. Never null; `[]` when
     * none.
     */
    ids: string[];
    /**
     * Number of selected rows kept rather than deleted (the length of
     * `kept_ids`), for example because the agent's process or a session of the
     * agent (its own, or a leftover of an earlier launch) may still run, tmux
     * could not be checked or answered from a different server, the run's tmux
     * time budget (`sweep_budget_seconds`) was spent, or the row changed after
     * it was examined.
     */
    kept: number;
    /**
     * Sorted ids of the selected rows kept rather than deleted, each reported
     * with its reason in the trail (`ad.expire.kept`). tmux problems and a
     * failed delete of one row never fail the run: the row is kept. A failed
     * read of the selected rows fails the run. A row another caller removed
     * first is in neither list. Never null; `[]` when none.
     */
    kept_ids: string[];
}
/** Parameters for writing a named template. */
export interface MakeTemplateParams {
    /** Template filename (without extension). Must be filename-safe. Required. */
    name: string;
    /** Default working directory to bake in. */
    cwd?: string;
    /**
     * The agent the template belongs to: `"claude"` (Claude Code), `"codex"` (Codex) or `"cursor"` (Cursor);
     * case-sensitive, empty or absent means not given. Required when the template bakes in
     * `agent_args` (otherwise `ErrTemplateAgentMissing`); a Codex or Cursor template cannot bake in
     * `allow`, `deny` or `ask` (`ErrPermissionsUnsupported`). Any other value is refused
     * with `ErrTemplateMalformed` (`ErrAgentInvalid` is spawn's per-call refusal). A spawn
     * that names no agent takes it from the template.
     */
    agent?: string;
    /** Default relay mode: "on" | "off" | "" (inherit). */
    relay_mode?: string;
    /** Default agent argv. Per-call `agent_args` replaces wholesale. Cursor uses the same supported argument subset as spawn; unsupported forms return `ErrSpawnDeniedFlag` before writing. */
    agent_args?: string[];
    /**
     * Env-var overrides to bake in. A key spawn would refuse is refused here with
     * `ErrReservedEnvKey` and nothing is written: `AGENT_DIRECTOR_*` keys, `HOME`
     * (any value), and a key that is not a valid env-var name (empty, or
     * containing `=` or a NUL character); the description says which. Set an absolute
     * `CLAUDE_CONFIG_DIR` (Claude Code) or `CODEX_HOME` (Codex) to give the agent its
     * own config folder.
     */
    extra_env?: Record<string, string>;
    /** Label k=v entries to bake in. */
    label?: string[];
    /** permissions.allow entries. */
    allow?: string[];
    /** permissions.deny entries. */
    deny?: string[];
    /** permissions.ask entries. */
    ask?: string[];
    /**
     * When true, an existing template at this name is replaced atomically
     * via a sibling-tempfile + rename. When omitted or false, the
     * existing-template rejection runs (v0.4.2 behaviour).
     */
    overwrite?: boolean;
}
/** The template's saved path. */
export interface MakeTemplateResult {
    /** Absolute path of the written template TOML file. */
    path: string;
}
/** Filters for listing tracked agent rows. */
export interface ListParams {
    /**
     * Filter by state (multiple values OR together). The filter matches the displayed state,
     * including `stuck`, and is applied before `limit`.
     */
    state?: string[];
    /** Filter by label k=v pairs (multiple entries AND together). */
    label?: string[];
    /** Filter by parent_id exact match. */
    parent?: string;
    /** Filter by canonicalized cwd exact match. */
    cwd?: string;
    /** Filter by tmux session name exact match. */
    tmux_session_name?: string;
    /** Cap result count. 0/omitted means no cap. A negative value is refused (ErrInvalidFlags). */
    limit?: number;
}
/** Matching tracked agent rows. */
export interface ListResult {
    /** Matching Spawn rows. Empty array when none match. */
    spawns: ListRow[];
}
/** The id whose subagent records are requested. */
export interface ListSubagentsParams {
    /** Id of the Spawn whose subagents to list. */
    instance_id: string;
}
/**
 * One subagent record. Every key is always present; a field with
 * no known value is `null`. Each time is an RFC3339 UTC string with millisecond precision
 * (trailing zeros dropped, no fraction on a whole second), exactly as the CLI prints it.
 */
export interface SubagentRecord {
    /** Experimental reading; unknown without evidence belonging to this child. */
    context: ContextReading;
    /** The subagent's id, unique among the records shown for its row. */
    subagent_id: string;
    /** The id of the row (agent) the subagent belongs to. */
    instance_id: string;
    /** The session of the event that created the record; never changed after. */
    session_id: string | null;
    /** The subagent's type. */
    subagent_type: string | null;
    /** The short description the launching call gave the subagent; never the prompt text. */
    description: string | null;
    /** The model the subagent runs. */
    model: string | null;
    /**
     * What launched the subagent: `"agent"` (the row's own agent, so `parent_id` is the row's
     * instance_id) or `"subagent"` (another subagent, so `parent_id` is that subagent's id).
     */
    parent_type: "agent" | "subagent" | null;
    /** The instance_id or the parent subagent's id, as `parent_type` says. */
    parent_id: string | null;
    /** The id of the tool call that launched the subagent. */
    tool_use_id: string | null;
    /** `"background"` or `"foreground"`. */
    run_mode: "background" | "foreground" | null;
    /** When the subagent first started. */
    first_started_at: string | null;
    /** When the subagent's latest run started. */
    started_at: string | null;
    /** When the subagent last stopped; null if it never has (kept when it runs again). */
    stopped_at: string | null;
    /** When the subagent was judged lost; null unless it was. */
    lost_at: string | null;
    /**
     * `"running"` (started, neither stopped nor judged lost), `"stopped"` (its agent reported it
     * finished) or `"lost"` (judged gone without a stop report).
     */
    state: string;
    /**
     * Why the subagent is no longer running; null exactly while `state` is `"running"`:
     * `"stop_event"` (its agent reported it finished), `"absent_from_snapshot"` (a snapshot of the
     * agent's running background tasks did not list it) or `"agent_gone"` (its agent ended, went
     * missing or began a new launch).
     */
    close_reason: "stop_event" | "absent_from_snapshot" | "agent_gone" | null;
}
/** The current life's subagent records and tracking status. */
export interface ListSubagentsResult {
    /**
     * Whether the row's launch registered subagent tracking: false for a row launched before
     * subagent tracking existed, which has no records, and false for a row whose launch
     * registers no subagent events; true for any other row.
     */
    tracked: boolean;
    /**
     * Every subagent record of the row's current life, across every launch of it, ordered by
     * `first_started_at` ascending (a null one last), then `subagent_id`. Empty array when it has none.
     */
    subagents: SubagentRecord[];
}
/** Parameters for asking a waiting agent to exit. */
export interface PauseParams {
    /** Id of the Spawn to pause gracefully. */
    instance_id: string;
}
/** Successful pause calls return an empty object. */
export interface PauseResult {
}
/** The version call takes no parameters. */
export interface VersionParams {
}
/** The installed npm package's version. */
export interface VersionResult {
    /** npm package version (e.g. "0.5.0"). Sourced from the installed agent-director package's package.json — not the CLI binary. */
    version: string;
    /** CLI binary's full git SHA. "unknown" for unstamped builds. */
    commit: string;
    /** Directory the CLI binary keeps agent-director's files in: "~/.config/agent-director", unexpanded, for every HOME. */
    config_dir: string;
}

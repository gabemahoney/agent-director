     * guard (any state including pending/ended/missing is always readable),
     * so this flag has no behavioral effect.
     */
    allow_pending?: boolean;
}
/** Captured pane text and its checksum. */
export interface ReadPaneResult {
    /** Captured pane text. */
    pane: string;
    /**
     * SHA-256, lowercase hex, of exactly the bytes of `pane`. Pass it as sendKeys' or
     * recordPaneAnswer's `expect_pane_sha256`, with the same `n_lines`, when acting on what this

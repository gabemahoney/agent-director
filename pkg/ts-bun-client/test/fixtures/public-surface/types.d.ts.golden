    instance_id: string;
    /**
     * Text to deliver to the pane on a plain call. CR bytes stripped; LF preserved; Enter
     * appended unless `no_enter`. Empty or omitted text sends Enter only: it submits what is
     * already typed, such as a text a failed sendKeys left unsubmitted. Exclusive with `key`;
     * must be empty on a pane answer.
     */
    text?: string;
    /**

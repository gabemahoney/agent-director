// Diagnostic-only package, installed by source-overlay.mjs into disposable builds.
package decideobserve

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"os"
	"strings"
	"sync/atomic"
	"time"
	"unicode/utf8"
)

const Capacity = 65536

var origin = time.Now()
var sequence atomic.Uint64
var reserved atomic.Uint64
var overflow atomic.Uint64
var slots [Capacity]slot

type key struct{}
type span struct {
	root, id, parent uint64
	instance, token  string
	invocation *Invocation
}
// Invocation is supplied by the external fixture owner as a value per actual
// call. State is recomputed here; no registry, shared-client mutation or clock
// matching is used. IDs must be unique within the retained process lifecycle.
type Invocation struct {
 Process string `json:"process"`
 Test string `json:"test"`
 Fixture string `json:"fixture"`
 Call string `json:"call"`
 State string `json:"state"`
}
type record struct {
	NS                       int64  `json:"ns"`
	Root                     uint64 `json:"root"`
	Span                     uint64 `json:"span"`
	Parent                   uint64 `json:"parent"`
	Phase                    string `json:"phase"`
	Instance                 string `json:"instance,omitempty"`
	Token                    string `json:"token,omitempty"`
	Invocation               *Invocation `json:"invocation,omitempty"`
	DeadlineNS               int64  `json:"deadline_ns,omitempty"`
	RemainingNS              int64  `json:"remaining_ns,omitempty"`
	ContextState             uint8  `json:"context_state"` // 0 live, 1 canceled, 2 expired
	Value                    int64  `json:"value,omitempty"`
	OperationContextRecorded bool   `json:"operation_context_recorded,omitempty"`
	OperationDeadlineNS      int64  `json:"operation_deadline_ns,omitempty"`
	OperationRemainingNS     int64  `json:"operation_remaining_ns,omitempty"`
	OperationContextState    uint8  `json:"operation_context_state"`
	StorePath                string `json:"store_path,omitempty"`
	StorePathState           string `json:"store_path_state,omitempty"`
	StorePathBytes           int    `json:"store_path_bytes,omitempty"`
	err                      error
}
type slot struct {
	ready  atomic.Bool
	record record
}

func bounded(s string, n int) string {
	if len(s) > n {
		return strings.Clone(s[:n])
	}
	return s
}

// Root is called before context creation. Bind preserves that context's exact
// cancellation/deadline while attaching the observation identity.
func Root(route, instance, token string) context.Context {
	return RootInvocation(route, instance, token, Invocation{})
}
func RootInvocation(route, instance, token string, invocation Invocation) context.Context {
	invocation.State = "complete"
	for _, id := range []string{invocation.Process, invocation.Test, invocation.Fixture, invocation.Call} {
		if len(id) > 128 { invocation.State = "truncated"; break }
		if !utf8.ValidString(id) { invocation.State = "invalid_utf8"; break }
		if id == "" { invocation.State = "missing" }
	}
	invocation.Process = bounded(invocation.Process, 128)
	invocation.Test = bounded(invocation.Test, 128)
	invocation.Fixture = bounded(invocation.Fixture, 128)
	invocation.Call = bounded(invocation.Call, 128)
	id := sequence.Add(1)
	ctx := context.WithValue(context.Background(), key{}, &span{root: id, id: id, instance: bounded(instance, 128), token: bounded(token, 128), invocation: &invocation})
	Event(ctx, route+".enter", nil)
	return ctx
}
func Bind(root, ctx context.Context) context.Context {
	if root == nil || root.Value(key{}) == nil { return ctx }
	return context.WithValue(ctx, key{}, root.Value(key{}))
}
func Child(ctx context.Context, phase string) context.Context {
	if ctx == nil {
		return ctx
	}
	p, ok := ctx.Value(key{}).(*span)
	if !ok {
		return ctx
	}
	c := &span{root: p.root, id: sequence.Add(1), parent: p.id, instance: p.instance, token: p.token, invocation: p.invocation}
	ctx = context.WithValue(ctx, key{}, c)
	Event(ctx, phase+".enter", nil)
	return ctx
}
func Event(ctx context.Context, phase string, err error)   { put(ctx, phase, err, 0) }
func Value(ctx context.Context, phase string, value int64) { put(ctx, phase, nil, value) }

// Counts is safe during a run; it does not drain/reset records or touch workers.
func Counts() (reservations, dropped uint64) { return reserved.Load(), overflow.Load() }

type storeIdentity struct {
	path, state string
	bytes       int
}

// StoreIdentity records the actual Store.Path at an existing operation boundary.
// It never changes the context or retains mutable Store state. Only complete
// paths may join fixtures; missing/truncated paths remain explicitly ambiguous.
func StoreIdentity(ctx context.Context, path string) {
	identity := storeIdentity{path: bounded(path, 1024), state: "complete", bytes: len(path)}
	if path == "" {
		identity.state = "missing"
	} else if len(path) > 1024 {
		identity.state = "truncated"
	} else if !utf8.ValidString(path) {
		identity.state = "invalid_utf8"
	}
	putContexts(ctx, ctx, "operation.store_identity", nil, 0, false, &identity)
}

// Boundary retains operation identity and samples the actual existing context
// used by admission or acquisition. Neither context is wrapped or replaced.
func Boundary(operationCtx, actualCtx context.Context, phase string, err error) {
	putContexts(operationCtx, actualCtx, phase, err, 0, true, nil)
}
func put(ctx context.Context, phase string, err error, value int64) {
	putContexts(ctx, ctx, phase, err, value, false, nil)
}
func putContexts(ctx, actualCtx context.Context, phase string, err error, value int64, boundary bool, identity *storeIdentity) {
	if ctx == nil {
		return
	}
	s, ok := ctx.Value(key{}).(*span)
	if !ok {
		return
	}
	i := reserved.Add(1) - 1
	if i >= Capacity {
		overflow.Add(1)
		return
	}
	now := time.Now()
	r := record{NS: now.Sub(origin).Nanoseconds(), Root: s.root, Span: s.id, Parent: s.parent,
		Phase: phase, Instance: s.instance, Token: s.token, Invocation: s.invocation, Value: value, err: err}
	if identity != nil {
		r.StorePath, r.StorePathState, r.StorePathBytes = identity.path, identity.state, identity.bytes
	}
	if end, ok := actualCtx.Deadline(); ok {
		r.DeadlineNS = end.Sub(origin).Nanoseconds()
		r.RemainingNS = end.Sub(now).Nanoseconds()
	}
	switch actualCtx.Err() {
	case context.Canceled:
		r.ContextState = 1
	case context.DeadlineExceeded:
		r.ContextState = 2
	}
	if boundary {
		r.OperationContextRecorded = true
		if end, ok := ctx.Deadline(); ok {
			r.OperationDeadlineNS = end.Sub(origin).Nanoseconds()
			r.OperationRemainingNS = end.Sub(now).Nanoseconds()
		}
		switch ctx.Err() {
		case context.Canceled:
			r.OperationContextState = 1
		case context.DeadlineExceeded:
			r.OperationContextState = 2
		}
	}
	slots[i].record = r
	slots[i].ready.Store(true)
}

type errorFact struct {
	Type          string `json:"type"`
	Text          string `json:"text"`
	Code          *int   `json:"sqlite_code,omitempty"`
	TextTruncated bool   `json:"text_truncated,omitempty"`
}

// Error methods and chain rendering occur only during export. Original error
// references are retained unchanged; no formatting/stack capture on timed paths.
func causes(err error) []errorFact {
	var out []errorFact
	var visit func(error, int)
	visit = func(e error, depth int) {
		if e == nil || depth == 4 || len(out) == 4 {
			return
		}
		message := e.Error()
		f := errorFact{Type: bounded(fmt.Sprintf("%T", e), 128), Text: bounded(message, 128), TextTruncated: len(message) > 128}
		if coder, ok := e.(interface{ Code() int }); ok {
			code := coder.Code()
			f.Code = &code
		}
		out = append(out, f)
		if many, ok := e.(interface{ Unwrap() []error }); ok {
			for _, child := range many.Unwrap() {
				if len(out) == 4 {
					break
				}
				visit(child, depth+1)
			}
		} else {
			visit(errors.Unwrap(e), depth+1)
		}
	}
	visit(err, 0)
	return out
}

// Export emits bounded JSONL after calls, without resetting slots or awaiting
// workers. Call again after a bounded drain to retain newly completed records.
// Each snapshot is a prefix reservation cutoff, not a quiescence guarantee.
// Missing reservations, unmatched enters and overflow are explicitly censored.
func Export(w io.Writer) error {
	cutoff := reserved.Load()
	limit := min(cutoff, uint64(Capacity))
	enc := json.NewEncoder(w)
	header := struct {
		Kind     string `json:"kind"`
		PID      int    `json:"pid"`
		Origin   string `json:"origin_wall"`
		CutoffNS int64  `json:"cutoff_ns"`
		Reserved uint64 `json:"reserved"`
		Overflow uint64 `json:"overflow"`
		Capacity int    `json:"capacity"`
	}{"snapshot", os.Getpid(), origin.UTC().Format(time.RFC3339Nano), time.Since(origin).Nanoseconds(), cutoff, overflow.Load(), Capacity}
	if err := enc.Encode(header); err != nil {
		return err
	}
	var missing uint64
	for i := uint64(0); i < limit; i++ {
		if !slots[i].ready.Load() {
			missing++
			continue
		}
		r := slots[i].record
		item := struct {
			Kind string `json:"kind"`
			Slot uint64 `json:"slot"`
			record
			Errors []errorFact `json:"errors,omitempty"`
		}{"event", i, r, causes(r.err)}
		if err := enc.Encode(item); err != nil {
			return err
		}
	}
	return enc.Encode(struct {
		Kind        string `json:"kind"`
		Unpublished uint64 `json:"unpublished_reservations"`
	}{"snapshot_end", missing})
}

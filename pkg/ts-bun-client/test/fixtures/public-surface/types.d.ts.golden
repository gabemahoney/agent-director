/**
 * Structural logger interface — mirrors the four conventional log levels.
 * All methods are optional; callers may pass any object that implements the
 * subset they care about (e.g., `console`).
 */
export interface Logger {
    debug?: (message: string, ...args: unknown[]) => void;
    info?: (message: string, ...args: unknown[]) => void;
    warn?: (message: string, ...args: unknown[]) => void;
    error?: (message: string, ...args: unknown[]) => void;
}
/**
 * Options accepted by the `Client` constructor.
 *
 * All fields are optional. When omitted, the installed CLI binary's own
 * three-tier default resolution applies (config.toml value, then the CLI's
 * hardcoded fallback such as `~/.config/agent-director/state.db`). The TS Client
 * does NOT provide a fallback; it forwards user input verbatim to keep the
 * CLI as the single source of truth for default resolution.
 *
 * `storePath`, `home` and `tmuxCommand` are forwarded verbatim; the TS Client
 * does no tilde expansion of its own. The CLI subprocess, which inherits this
 * process's environment, expands `~`: a bare `~` or a leading `~/` in `home`
 * against the inherited `HOME`, then a leading `~/` in `storePath` and
 * `tmuxCommand` (and a bare `~` in `tmuxCommand`) against the resulting
 * `HOME`, which is `home` when set. The CLI never resolves `~` against the
 * passwd home: with `HOME` unset or empty, a `~` or `~/` `home` rejects every
 * call with `ErrInvalidFlags`, and with no `home` either, every call that
 * opens the store is refused. Other values, relative paths included, are
 * forwarded unchanged and the CLI resolves them.
 *
 * An empty `storePath`, `home` or `tmuxCommand` is forwarded as given (e.g.
 * `--store-path ""`); the CLI rejects it on every verb call, which then
 * rejects with `ErrInvalidFlags`. It never falls back to the default.
 */
export interface ClientOptions {
    /**
     * Path to the SQLite store file. Forwarded verbatim as `--store-path` to the
     * CLI subprocess, which expands a leading `~/`.
     *
     * When omitted, the CLI's three-tier default resolution applies:
     *   1. CLI flag (this field, when set) → 2. [store] db_path in
     *   ~/.config/agent-director/config.toml → 3. hardcoded fallback
     *   ~/.config/agent-director/state.db.
     *
     * The TS Client forwards the option unchanged.
     */
    storePath?: string;
    /**
     * Override the tmux binary. Forwarded verbatim as `--tmux-command` to the
     * CLI subprocess, which expands a bare `~` or a leading `~/`. When omitted,
     * the CLI looks up `tmux` on PATH.
     */
    tmuxCommand?: string;
    /**
     * Override HOME for the duration of every subprocess call this Client
     * issues. Forwarded verbatim as `--home` to the CLI subprocess, which
     * expands a bare `~` or a leading `~/` against the inherited `HOME`.
     *
     * When omitted, the CLI subprocess inherits HOME from the calling process
     * environment (which is the correct default — set HOME at the
     * test-process level via withTempHome or similar). Set this only when you
     * need the CLI to resolve `~/...` paths against a specific directory that
     * differs from the calling process's HOME.
     */
    home?: string;
    /**
     * Whether a call that opens the store creates it when it does not exist.
     *
     * - Omitted: the CLI's default, which creates a missing store.
     * - `true`: a missing store is created (parent directories, file and
     *   schema) by the first call that opens it. No flag is forwarded, since
     *   this is the CLI's default.
     * - `false`: forwarded as `--create-if-missing false`. A call that opens a
     *   missing store rejects with `ErrStoreOpen` (its cause: the store is not
     *   initialized) and creates none of it. Calls that open no store, such as
     *   `version`, are unaffected.
     *
     * `true` and `false` mirror `pkg/api.Options.CreateIfMissing`; unlike that
     * field, omitting this one keeps the CLI's default, which creates the store.
     * `false` needs a CLI binary that knows `--create-if-missing`: an older
     * binary rejects every call made with it.
     */
    createIfMissing?: boolean;
    /** Optional logger for client-side warnings (e.g., non-fatal close errors). */
    logger?: Logger;
    /**
     * Per-call timeout for the subprocess Client, in milliseconds. Default: 30000 (30 s).
     * Cursor launch returns before ACP readiness; initialize and session creation/load
     * have separate 45 s bounds. Generation or an unanswered dialog is not the launch call.
     *
     * When a subprocess call exceeds this threshold the Client sends SIGTERM,
     * waits up to 2 seconds for a graceful exit, then sends SIGKILL. The
     * in-flight call's promise rejects with ErrCallTimeout.
     *
     * Zero or negative values are rejected at Client construction time.
     *
     * Each store statement a call runs can wait up to the store's busy
     * timeout (`[store] busy_timeout_ms`, 10 s by default) while another
     * process holds the store locked. A call whose waits add up to this
     * timeout, one wait at this length or more or several shorter ones, is
     * cut off with ErrCallTimeout before SQLite gives up. Nothing adjusts this
     * timeout to that key: raise it to match when raising the key.
     */
    callTimeoutMs?: number;
}
/** One entry in the `help` verb result. */
export interface VerbSummary {
    /** Canonical CLI/MCP verb name (e.g. "spawn", "send-keys"). */
    name: string;
    /** One-line verb description from the manifest. */
    description: string;
}
/**
 * A permission request's delivery state:
 * - `"delivered"`: the relay durably acknowledged a verdict before enqueue/write;
 *   this is not agent receipt, tool execution or dialog closure.
 * - `"not_confirmed"`: no ack yet and the relay hook may still run; it ends by `confirm_by`.
 * - `"fallen_back"`: no ack, and the relay hook is gone (or cannot be checked and `confirm_by`
 *   has passed): no answer from the relay reached the agent. While `pane_answer` is `"none"` or
 *   `"intent"` the request awaits an answer unless acknowledged or closed with its Spawn. A pane
 *   answer, `recordPaneAnswer` or validated execution proof can close it; with `"sent"`,
 *   `"outside"` or `"tool_ran"` it is closed.
 */
export type Delivery = "delivered" | "not_confirmed" | "fallen_back";
/**
 * How a permission request was answered at the pane:
 * - `"none"`: no pane answer recorded through agent-director (something outside it, such as a
 *   person at tmux, may still have answered it).
 * - `"intent"`: a pane answer through `sendKeys` was started; whether its key was typed is unknown.
 * - `"sent"`: a pane answer's key was sent or Cursor recorded its native choice
 *   (`decision_reason` `"pane"`); this does not establish ACP delivery, receipt or proof.
 * - `"outside"`: a caller recorded it answered outside agent-director (`recordPaneAnswer`,
 *   `decision_reason` `"pane_outside"`).
 * - `"tool_ran"`: agent hooks or validated correlated Cursor execution output established
 *   its tool ran. The hook close records `decision` `"allow"` and `decision_reason` `"tool_ran"`;
 *   Cursor proof preserves any earlier verdict and non-null reason, filling a missing reason
 *   with `"tool_ran"`.
 * `"sent"`, `"outside"` and `"tool_ran"` close the request; its `delivery` stays `"fallen_back"`.
 */
export type PaneAnswer = "none" | "intent" | "sent" | "outside" | "tool_ran";
/**
 * A permission request's delivery facts, with whether agent evidence proved its dialog gone, on every
 * `get` / `list` permission request and `get`'s `unproven_requests`, on `getPermission` and on
 * `decide`'s result. Derived on every read. A recorded `decision` is not the outcome:
 * `delivery` is.
 */
export interface RequestDelivery {
    /** Delivery state; see {@link Delivery}. */
    delivery: Delivery;
    /**
     * RFC3339 time by which `not_confirmed` ends: the relay hook's kill instant plus 2 s. For a
     * request with no recorded settle instant: `requested_at` plus the relay window plus 2 s.
     * Cursor uses its finite persisted per-request settlement, independent of gateway lifetime;
     * relay-off requests settle immediately.
     */
    confirm_by: string;
    /**
     * Whether the relay hook process runs: true, false, or null when it cannot be checked
     * (another or unreadable pid namespace, unreadable /proc, or no recorded hook identity).
     * Cursor gateway-local controllers have no hook identity: null, never the gateway PID.
     */
    hook_alive: boolean | null;
    /** When a reader first found the request fallen back; null until then. */
    hook_gone_at: string | null;
    /** The verdict a decide refused as fallen back tried to record; null when none. Never acted on. */
    attempted_decision: "allow" | "deny" | null;
    /** When that refused decide ran; null when none. */
    attempted_at: string | null;
    /** Hook tool_use_id or Cursor's supplied toolCallId; null when none was given. */
    tool_use_id: string | null;
    /** How the request was answered at the pane; see {@link PaneAnswer}. */
    pane_answer: PaneAnswer;
    /**
     * The verdict a pane answer claims: allow, deny, or unknown (an outside record that did not see
     * the answer); null when none was recorded. Public send-keys and outside records store a claim
     * without screen verification or proof. Before answering ACP, Cursor additionally requires a sent
     * claim to match the actual selected option verdict. An outside record never authorizes an ACP answer.
     */
    pane_as: "allow" | "deny" | "unknown" | null;
    /**
     * When agent evidence proved the request's permission dialog gone; null until
     * then. agent-director's own records (`delivered`, a pane answer, `recordPaneAnswer`) are not
     * proof. While it is null, a plain `sendKeys` to the live Spawn without `expect_pane_sha256`,
     * and a `pause`, reject with `ErrDialogMaybeOpen`.
     */
    proven_gone_at: string | null;
    /** How it was proven gone; see {@link ProvenGoneHow}. Null until proven. */
    proven_gone_how: ProvenGoneHow | null;
    /**
     * For a request not proven gone that no longer awaits an answer in agent-director's records:
     * when its record stopped awaiting one (its relay hook's ack, its pane answer's or
     * `recordPaneAnswer`'s write, or the close of its Spawn's requests; a request with no recorded settle instant: its recorded verdict). Null while it still awaits an answer, and once proven
     * gone. A request that stays unproven a while after it is a reason to read the pane.
     */
    unproven_since: string | null;
}
/**
 * How agent evidence proved a permission request's dialog gone:
 * - `"tool_ran"`: a Claude PostToolUse or PostToolUseFailure carried its `tool_use_id`, or
 *   validated correlated Cursor execution output established that exact tool ran (never on a Codex row).
 * - `"turn_end"`: the turn of the agent that asked ended after it was written; the main agent's
 *   Stop or idle-prompt Notification, a Codex main agent's Interrupt (Esc), or a verified
 *   Cursor main Stop/Interrupt proves only a durably main-turn-eligible request recorded
 *   before the hook began. Legacy non-Cursor main requests retain eligibility; Cursor
 *   unknown-origin and child requests remain ineligible even without a child id. Decisions,
 *   delivery acknowledgements and pane-answer claims do not grant eligibility.
 * - `"agent_gone"`: its Spawn was marked missing, ended or resumed.
 */
export type ProvenGoneHow = "tool_ran" | "turn_end" | "agent_gone";
/**
 * One permission request with its delivery facts:
 * an open one (still awaiting an answer) in the `permission_requests` of a `get` or `list` row in
 * state check_permission; one not proven gone, open or read closed, in `get`'s
 * `unproven_requests`; and the request an `errDetails` names (the base of
 * `RelayFallenBackDetails` and `DialogMaybeOpenDetails`).
 */
export interface PermissionRequestInfo extends RequestDelivery {
    /** Autoincrement primary key of the permission_requests row. */
    request_id: number;
    /** UUIDv4 token minted by the relay controller for this request. Pass to the decide verb to target a specific row. */
    request_token: string;
    /** Supplied tool name (e.g. "Bash") or Cursor action title/plan name. */
    tool_name: string;
    /** Raw JSON string, not a nested object. Cursor preserves the entire received permission/plan
     * params envelope byte for byte, including options and absent/null fields, without internal context. */
    tool_input: string;
    /** RFC3339 timestamp when the permission request row was created. */
    requested_at: string;
    /** The recorded verdict, not the outcome (read `delivery`); null while none is recorded. */
    decision: "allow" | "deny" | null;
    /** The recorded verdict's decision_reason; null when none is recorded. */
    decision_reason: string | null;
}
/**
 * Why a row reads `stuck`: a current unanswered permission fallback, or a working Claude or
 * Codex pane whose fingerprint stayed identical across reads for its timeout.
 */
export type StuckReason = "permission_unanswered" | "no_screen_change";
/**
 * Whether `no_screen_change` can apply to a row's agent: `"available"` for Claude and Codex,
 * `"unavailable"` for Cursor. A capability outcome, never a stuck reason.
 */
export type NoScreenChangeAvailability = "available" | "unavailable";
/** One Spawn row returned by the list verb. */
export interface ListRow {
    /** Report-only condition; live command guards continue to apply. */
    stuck_reason?: StuckReason;
    /** Whether `no_screen_change` can apply to the row's agent: `"unavailable"` for Cursor. */
    no_screen_change_availability: NoScreenChangeAvailability;
    /** Stable Spawn id. */
    instance_id: string;
    /** Parent Spawn id (omitted when launched from a plain shell). */
    parent_id?: string;
    /**
     * Current lifecycle state (pending/waiting/working/ask_user/check_permission/ended/missing/stuck).
     * pending means a launch (spawn, reuse or resume) is in progress and the agent has not
     * reported in yet (its SessionStart hook); it may be loading or waiting at a startup
     * prompt. A resumed pending row keeps its session id and history.
     *
     * With `[state] settle_ms` set in the CLI's config.toml (whole milliseconds; 0 or unset is
     * off), this is the settled state: a state a hook wrote shows only once it has held for
     * settle_ms, and the last settled state shows meanwhile, so a change that reverts sooner never
     * shows; ended, missing and a state a command wrote (spawn, resume, find-missing) show at once.
     * Nothing marks a state as late. The row's other fields, and the verbs that act on it, follow
     * its live state, which can be newer: a refusal can name a state this field does not show yet.
     */
    state: string;
    /**
     * Complete stored family: self and live descendants, including through retained terminal
     * intermediates. Waiting means every live member is waiting, or no live members remain.
     * Uses raw member states and settles once in either direction with `[state] settle_ms`,
     * independently of `state`. This report does not establish readiness or task success.
     */
    family_state: "working" | "waiting";
    /** Canonicalized working directory. */
    cwd: string;
    /** The agent the row runs: `"claude"` (Claude Code), `"codex"` (Codex) or `"cursor"` (Cursor). Set at spawn; resume follows it. */
    agent: string;
    /** tmux session name. */
    tmux_session_name: string;
    /** "on" or "off". */
    relay_mode: string;
    /** Caller-supplied key-value tags. */
    labels: Record<string, string>;
    /** Row insert time (RFC3339). */
    started_at: string;
    /** Most recent hook UPSERT time (RFC3339). */
    last_seen_at: string;
    /**
     * When the raw state last changed (RFC3339 UTC, millisecond precision), on every row.
     * Soft refreshes and same-state writes leave it; `state` may still show the earlier
     * settled value. `1970-01-01T00:00:00Z` when the raw state has not changed since
     * agent-director began recording it. Not a stuck row's `since`. A Cursor row that get
     * or list finds lost reads `missing` at once; this moves when that mark is stored, which
     * can be after the read that first shows `missing`.
     */
    state_changed_at: string;
    /** Set when state moves to ended (omitted while live). */
    ended_at?: string | null;
    /**
     * Start of the launch in progress (RFC3339 UTC, millisecond precision); present only on a
     * pending row, omitted otherwise. It follows the row's live state: with `[state] settle_ms`
     * set, a row whose agent has reported in can read pending without it for up to settle_ms.
     */
    launch_started_at?: string | null;
    /**
     * RFC3339 timestamp of the first sweep that noted this live row (left it
     * unverified, or noted it `unreported`); kept while later sweeps change
     * `liveness_note`, `unreported` included. Cleared together with
     * `liveness_note` when a sweep finds the agent process alive, except on a
     * pending row it notes `unreported` and a pending row noted
     * `provenance_conflict`, which keeps it; omitted/null while the row has no
     * note.
     */
    liveness_unverified_since?: string | null;
    /**
     * Reason token of the latest sweep that left this live row unverified (its
     * agent process could not be checked and tmux did not settle it), for
     * example `process_not_seen_session_present`,
     * `process_not_seen_tmux_unchecked`, `probe_eacces`, `tmux_server_changed`
     * or `provenance_conflict`; overwritten when the reason changes. Cleared
     * together with `liveness_unverified_since` when a sweep finds the agent
     * process alive, except on a pending row it notes `unreported` and a
     * pending row noted `provenance_conflict`, which keeps it; omitted/null
     * while the row has no note. Or `unreported`, on a pending row past the
     * pending grace period: its agent is alive, but no hook has reported since
     * its launch, so it may sit at an agent startup screen or idle at its
     * prompt. The row stays pending. To act on it: `readPane`, then `sendKeys`
     * with `allow_pending`; only a caller that looked should type. A later
     * sweep that finds the agent alive keeps the note; the agent's next hook
     * clears it. `unreported` never replaces `provenance_conflict`.
     */
    liveness_note?: string | null;
    /**
     * The row's open permission requests (those still awaiting an answer), each with its
     * delivery facts; populated only when the row's live state is check_permission, `[]`
     * otherwise. A row can read waiting, working or ask_user while a request is still open:
     * follow a tracked request with `getPermission`. Requests are never delayed by
     * `[state] settle_ms`, so with it set a row can also read any state (even ended or missing)
     * with open requests listed, or check_permission with `[]`, for up to settle_ms.
     */
    permission_requests: PermissionRequestInfo[];
}
/** Parameters for launching a tracked agent. */
export interface SpawnParams {
    /** Absolute (or ~/-prefixed) path the Spawn's agent starts in. Required. */
    cwd: string;
    /** Named template under ~/.config/agent-director/templates/. */
    template?: string;
    /**
     * The agent to launch: `"claude"` (Claude Code), `"codex"` (Codex) or `"cursor"` (Cursor); case-sensitive,
     * empty or absent means not given. Spawn resolves it per call, else from `template`'s
     * `agent`; with neither, the spawn is refused with `ErrAgentMissing`. Any other value is
     * refused with `ErrAgentInvalid`. A template's `agent_args` belong to the template's agent
     * and are refused with `ErrAgentArgsMismatch` when the spawn's agent differs, unless this call
     * passes its own non-empty `agent_args`. The
     * row records it for life; `get` and `list` show it.
     */
    agent?: string;
    /** Explicit instance id (UUID4 minted when absent). */
    instance_id?: string;
    /** KEY=VALUE label pairs. */
    label?: string[];
    /** permissions.allow entries. */
    allow?: string[];
    /** permissions.deny entries. */
    deny?: string[];
    /** permissions.ask entries. */
    ask?: string[];
    /** "on" | "off" | "" (use config default). */
    relay_mode?: string;
    /**
     * KEY→VALUE env-var overrides injected on the tmux session. `AGENT_DIRECTOR_*`
     * keys and `HOME` (any value) are refused with `ErrReservedEnvKey`, a template's
     * included: an extra_env `HOME` would move the agent's hook to another
     * agent-director store. Set an absolute `CLAUDE_CONFIG_DIR` (Claude Code) or
     * `CODEX_HOME` (Codex) to give the agent its own config folder. A key that is not a valid env-var name (empty, or
     * containing `=` or a NUL character, which tmux would read as a different
     * variable) is refused with `ErrReservedEnvKey` too, a template's included,
     * and never rewritten; the description says what is wrong with it, and
     * nothing is launched.
     */
    extra_env?: Record<string, string>;
    /**
     * Pass-through argv to the agent's program. Claude always refuses `--settings`,
     * `--output-format` and print (`-p`/`--print`, parsed clusters included). Session
     * selectors and owned values are refused except on a finished-agent switch:
     * removed tokens appear in `dropped_args`; the agent starts fresh and resumes nothing.
     * Exact denied long tokens owned as option values always refuse. For codex, a Codex subcommand in
     * command position, `--remote`, `--remote-auth-token-env`, `-c`/`--config` keys at, above or
     * under `hooks`, `tui.disable_paste_burst`, `features.hooks` or its alias
     * `features.codex_hooks`, and `--disable hooks` or `codex_hooks` are refused
     * (`ErrSpawnDeniedFlag`); with `disable_ask_user` on, `--enable
     * default_mode_request_user_input` and the question-tool keys are refused too. agent-director
     * adds no second `--no-daemon`, `--dangerously-bypass-hook-trust` (pre-trust ok) or
     * `--enable write_stdin_approval` when the arguments already carry one before any `--`;
     * Codex rejects a flag the arguments themselves repeat.
     * Cursor accepts `--model`/`-m` (split or equals), `--mode` (agent/plan/ask),
     * `--plan`, and one final initial prompt (use `--` before a flag-like prompt).
     * Explicit mode is configured through ACP before prompt admission; launch
     * success alone does not confirm it. Other or malformed arguments are refused
     * with `ErrSpawnDeniedFlag`; remove the named argument and any owned value, then retry.
     */
    agent_args?: string[];
    /**
     * Skip the folder pre-trust for `cwd`. For a claude agent, that is pre-writing the
     * folder-trust entry (into `<CLAUDE_CONFIG_DIR>/.claude.json` when `extra_env` sets
     * `CLAUDE_CONFIG_DIR`, otherwise `~/.claude.json`). For a codex agent, it is putting the
     * folder trust and the hook-trust bypass on the launch's command line (no file is
     * written). Cursor grants no trust: default false reports `failed` (ACP
     * pre-trust unsupported); true reports `skipped`. Permission policy is independent.
     * The choice is recorded on the row until the next spawn or reuse,
     * and every `resume` follows it. The result then reports
     * `pre_trust: "skipped"`. Default false.
     */
    no_pre_trust?: boolean;
    /** Explicit tmux session name. Auto-derived when absent. */
    tmux_session_name?: string;
    /**
     * Reuse an explicit `instance_id` whose row is `ended` or `missing`;
     * a live row, `pending` included, still collides. No effect without an
     * explicit `instance_id`; applies to this call only. The spawn names its
     * agent (`agent`, or the template's) and the reused row takes it; to reuse
     * a row for the agent it ran, pass the row's agent, which `get` shows.
     * Same-agent reuse starts a fresh conversation and retains history and subagent records.
     * An agent switch or switch back starts a new life, hiding earlier lives.
     * Resume continues only the latest session; older sessions are for inspection only.
     * Default false: any existing row with the id collides with
     * `ErrInstanceIdCollision`.
     */
    reuse_finished?: boolean;
    /**
     * This row's `no_screen_change` timeout in whole seconds, 1 to 9223372036, used by every
     * `status`, `get` and `list` in place of `[state] no_screen_change_timeout_seconds`.
     * `0`, `null` or omitted gives no override. A negative, fractional, non-numeric or larger
     * value is refused with `ErrInvalidFlags` before anything is written or launched. Recorded
     * on the row: `resume` keeps it; the next spawn or reuse replaces it, clearing it when that
     * call gives none. Cursor rows keep it, but `no_screen_change` is unavailable for them.
     */
    no_screen_change_timeout_seconds?: number | null;
}
/**
 * The launch result. The row is `pending` from its insert until
 * the agent reports in (Cursor: verified first prompt), then `waiting`.
 * Cursor initialization, session creation and requested mode validation happen
 * asynchronously. This result does not confirm them; later failure appears in
 * the pane and ad.cursor.failed. Missing still requires process evidence.
 */
export interface SpawnResult {
    /** The id the new Spawn is tracked under. */
    instance_id: string;
    /**
     * Cursor grants no trust: `"failed"` by default (ACP pre-trust unsupported),
     * `"skipped"` with `no_pre_trust`; never `"ok"`. Permission policy is independent.
     * For Claude/Codex, what the launch's folder-trust pre-trust did. `"ok"`: the folder trust took effect
     * (claude: the entry was written to `.claude.json`; codex: the launch carries the folder
     * trust and the hook-trust bypass). `"skipped"`: pre-trust was off for this launch because the caller passed
     * `no_pre_trust`; nothing was attempted. `"failed"`: pre-trust was attempted and the
     * entry was not written (a claude agent: the `.claude.json` file is missing, or could not
     * be read, parsed or written, or `extra_env` sets `CLAUDE_CONFIG_DIR` to a path that is
     * not absolute; a codex agent: `extra_env` sets `CODEX_HOME` to a path that is not
     * absolute, and the launch carries neither the folder trust nor the hook-trust bypass);
     * the agent may stop at its folder-trust prompt. A pre-trust failure never fails the
     * spawn.
     */
    pre_trust: "ok" | "skipped" | "failed";
    /** Original resume tokens removed on a finished-agent switch, in argv order; omitted when empty. */
    dropped_args?: string[];
}
/** The id whose state is requested. */
export interface StatusParams {
    /** Id of the Spawn to inspect. */
    instance_id: string;
}
/** The row's reported lifecycle state. */
export interface StatusResult {
    /** Report-only condition; live command guards continue to apply. */
    stuck_reason?: StuckReason;
    /** Actual committed display-entry time, RFC3339 UTC with millisecond precision. */
    since?: string;
    /** Earliest qualifying fallback, lexical request-token tie break. */
    request_token?: string;
    tool_name?: string;
    /** Completed minutes of the committed unchanged pane period; only while `no_screen_change`. */
    unchanged_minutes?: number;
    /** Attach target, present when displayed stuck. */
    tmux_session_name?: string;
    /** Whether `no_screen_change` can apply to the row's agent: `"unavailable"` for Cursor. */
    no_screen_change_availability: NoScreenChangeAvailability;
    /** Experimental context estimate for the current session. */
    context: ContextReading;
    /**
     * Current lifecycle state (pending/waiting/working/ask_user/check_permission/ended/missing/stuck).
     * pending means a launch (spawn, reuse or resume) is in progress and the agent has not
     * reported in yet (its SessionStart hook); it may be loading or waiting at a startup
     * prompt. A resumed pending row keeps its session id and history; a caller tells it
     * from a fresh one by its non-empty `session_id`, shown by `get`.
     *
     * With `[state] settle_ms` set in the CLI's config.toml (whole milliseconds; 0 or unset is
     * off), this is the settled state: a state a hook wrote shows only once it has held for
     * settle_ms, and the last settled state shows meanwhile, so a change that reverts sooner never
     * shows; ended, missing and a state a command wrote (spawn, resume, find-missing) show at once.
     * Nothing marks a state as late. The verbs that act on the Spawn follow its live state, which
     * can be newer: a refusal can name a state status does not show yet.
     */
    state: string;
    /**
     * Complete stored family: self and live descendants, including through retained terminal
     * intermediates. Waiting means every live member is waiting, or no live members remain.
     * Uses raw member states and settles once in either direction with `[state] settle_ms`,
     * independently of `state`. This report does not establish readiness or task success.
     */
    family_state: "working" | "waiting";
    /**
     * Start of the launch in progress (RFC3339 UTC, millisecond precision); present only on a
     * pending row, omitted otherwise. It follows the row's live state: with `[state] settle_ms`
     * set, a row whose agent has reported in can read pending without it for up to settle_ms.

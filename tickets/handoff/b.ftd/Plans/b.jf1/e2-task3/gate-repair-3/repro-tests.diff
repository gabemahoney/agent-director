+// prepareRunPTY reuses the verified pane for Run's fresh runtime registration.
+func (e *requestEnv) prepareRunPTY(t *testing.T) (*os.File, *os.File) {
+	t.Helper()
+	if err := e.process.terminate(); err != nil {
+		t.Fatal(err)
+	}

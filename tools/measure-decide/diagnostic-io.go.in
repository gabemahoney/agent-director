package PACKAGE

import (
 "context"
 "crypto/rand"
 "database/sql"
 "encoding/hex"
 "encoding/json"
 "fmt"
 "os"
 "path/filepath"
 "strings"
 "sync"
 "sync/atomic"
 "testing"
 "time"
 // OBS_IMPORT
)
// INVOCATION_TYPE
var diagnosticSeq atomic.Uint64
var diagnosticMu sync.Mutex
var diagnosticOrigin = time.Now()
var diagnosticProcess = diagnosticNewID()
var diagnosticFixtures = map[string]string{}
var diagnosticOwners = map[string]string{}
var diagnosticCalls = []map[string]any{}
var diagnosticSnapshots = []map[string]any{}
var diagnosticStop atomic.Bool
var diagnosticMode = "MODE"
var diagnosticArtifactBytes int64
var diagnosticArtifactCount atomic.Uint64
var diagnosticFirstInvocation diagnosticInvocation
func diagnosticObserved(id diagnosticInvocation) diagnosticInvocation {
 diagnosticMu.Lock();defer diagnosticMu.Unlock()
 if diagnosticFirstInvocation.Call=="" {diagnosticFirstInvocation=id}
 switch os.Getenv("DECIDE_IDENTITY_FAULT") {
 case "missing": id.Fixture=""
 case "truncated": id.Call=strings.Repeat("x",129)
 case "invalid_utf8": id.Test=string([]byte{0xff})
 case "duplicate": id=diagnosticFirstInvocation
 case "wrong_process": id.Process="unrelated-lifecycle"
 }
 return id
}
func diagnosticNewID() string {
 var b [16]byte
 if _,err:=rand.Read(b[:]);err!=nil {panic(err)}
 return hex.EncodeToString(b[:])
}
func init() {
 if os.Getenv("DECIDE_REPORT")=="" {panic("DECIDE_REPORT missing")}
 diagnosticMu.Lock();defer diagnosticMu.Unlock()
 if err:=diagnosticInventory("started");err!=nil {panic(err)}
}
func diagnosticInventory(state string) error {
 out:=map[string]any{"process":diagnosticProcess,"pid":os.Getpid(),"origin_wall":diagnosticOrigin.UTC().Format(time.RFC3339Nano),"mode":diagnosticMode,"package":"PACKAGE","state":state,"identity_fault":os.Getenv("DECIDE_IDENTITY_FAULT"),"required_labels":[]string{"tests-complete","final"},"snapshots":diagnosticSnapshots,"calls":diagnosticCalls}
 data,err:=json.MarshalIndent(out,"","  ");if err!=nil{return err}
 dir:=os.Getenv("DECIDE_REPORT")
 target:=filepath.Join(dir,"process-"+diagnosticProcess+".json")
 if err=os.WriteFile(target+".tmp",append(data,'\n'),0600);err!=nil{return err}
 return os.Rename(target+".tmp",target)
}
func diagnosticBegin(t *testing.T,path,route string) diagnosticInvocation {
 t.Helper()
 if diagnosticStop.Load() {t.Fatal("diagnostic first-error admission stopped")}
 return diagnosticBeginNamed(t.Name(),path,route)
}
func diagnosticRegister(t *testing.T,path string) {
 diagnosticMu.Lock();defer diagnosticMu.Unlock()
 if owner,ok:=diagnosticOwners[path];ok && owner!=t.Name() {panic("conflicting fixture owner")}
 diagnosticOwners[path]=t.Name()
}
func diagnosticStoreBegin(path,route string) diagnosticInvocation {
 diagnosticMu.Lock();owner:=diagnosticOwners[path];diagnosticMu.Unlock()
 if owner=="" {panic("missing store fixture owner")}
 return diagnosticBeginNamed(owner,path,route)
}
func diagnosticBeginNamed(test,path,route string) diagnosticInvocation {
 diagnosticMu.Lock();defer diagnosticMu.Unlock()
 if len(diagnosticCalls)>=4096 {panic("diagnostic invocation count cap exceeded")}
 fixture,ok:=diagnosticFixtures[path]
 if !ok {fixture=diagnosticNewID();diagnosticFixtures[path]=fixture}
 id:=diagnosticInvocation{Process:diagnosticProcess,Test:test,Fixture:fixture,Call:fmt.Sprintf("call-%d",diagnosticSeq.Add(1))}
 diagnosticCalls=append(diagnosticCalls,map[string]any{"process":id.Process,"test":id.Test,"fixture":id.Fixture,"call":id.Call,"route":route,"path":path,"state":"started","entry_ns":time.Since(diagnosticOrigin).Nanoseconds()})
 return id
}
func diagnosticReturned(id diagnosticInvocation,begin,end time.Time,err error,expected bool) {
 diagnosticMu.Lock();defer diagnosticMu.Unlock()
 for _,r:=range diagnosticCalls {if r["call"]==id.Call {r["state"]="completed";r["return_ns"]=end.Sub(diagnosticOrigin).Nanoseconds();r["duration_ns"]=end.Sub(begin).Nanoseconds();r["expected_error"]=expected;if err!=nil {r["error"]=err.Error()};return}}
 panic("unknown diagnostic invocation return")
}
func diagnosticCapture(t *testing.T,path,label string) {
 t.Helper()
 if err:=diagnosticSnapshot(label);err!=nil {t.Errorf("diagnostic snapshot: %v",err)}
}
func diagnosticSnapshot(label string) error {
 // OBS_EXPORT
 return nil
}
func diagnosticFinish() error {
 if err:=diagnosticSnapshot("tests-complete");err!=nil{return err}
 // FINAL_DRAIN
 if err:=diagnosticSnapshot("final");err!=nil{return err}
 diagnosticMu.Lock();defer diagnosticMu.Unlock()
 return diagnosticInventory("completed")
}
// An independent bounded read transaction. It never issues a decision.
func diagnosticReadback(t *testing.T,path,label string,ids ...diagnosticInvocation) {
 t.Helper()
 started:=time.Now()
 diagnosticMu.Lock();fixture:=diagnosticFixtures[path]
 related:=[]string{};for _,c:=range diagnosticCalls {if c["test"]==t.Name()&&c["path"]==path {related=append(related,c["call"].(string))}}
 diagnosticMu.Unlock()
 out:=map[string]any{"process":diagnosticProcess,"test":t.Name(),"fixture":fixture,"related_calls":related,"call_join":"fixture snapshot covers enumerated invocations; no per-call causal inference","label":label,"started_wall":started.UTC().Format(time.RFC3339Nano),"cutoff_ns":started.Sub(diagnosticOrigin).Nanoseconds(),"path":path,"coherent":false,"availability":"unavailable"}
 if len(ids)==1 {out["call"]=ids[0].Call;out["call_join"]="explicit actual invocation supplied by caller"}
 ctx,cancel:=context.WithTimeout(context.Background(),time.Second);defer cancel()
 db,err:=sql.Open("sqlite","file:"+path+"?mode=ro&_pragma=busy_timeout(0)")
 if err==nil {
  defer db.Close();db.SetMaxOpenConns(1)
  var tx *sql.Tx
  tx,err=db.BeginTx(ctx,&sql.TxOptions{ReadOnly:true})
  if err==nil {
   defer tx.Rollback()
   var schema int
   err=tx.QueryRowContext(ctx,"PRAGMA user_version").Scan(&schema);out["schema_version"]=schema
   for _,table:=range []string{"spawns","permission_requests","cursor_runtimes","subagents","subagent_launches"} {
    if err!=nil {break}
    var rows *sql.Rows
    rows,err=tx.QueryContext(ctx,"SELECT * FROM "+table+" LIMIT 257")
    if err!=nil {out["failed_table"]=table;break}
    var cols []string;cols,err=rows.Columns()
    facts:=[]map[string]any{}
    for err==nil && rows.Next() {
     vals:=make([]any,len(cols));ptrs:=make([]any,len(cols));for i:=range vals {ptrs[i]=&vals[i]}
     if err=rows.Scan(ptrs...);err!=nil {break}
     fact:=map[string]any{}
     for i,col:=range cols {if b,ok:=vals[i].([]byte);ok {fact[col]=string(b)} else {fact[col]=vals[i]}}
     facts=append(facts,fact)
     if len(facts)>256 {err=fmt.Errorf("readback row cap: %s",table);break}
    }
    if err==nil {err=rows.Err()};rows.Close();out[table]=facts
   }
   if err==nil {err=tx.Commit();if err==nil {out["coherent"]=true;out["availability"]="complete bounded read transaction"}}
  }
 }
 if err!=nil {out["error"]=err.Error()}
 out["duration_ns"]=time.Since(started).Nanoseconds()
 out["completed_ns"]=time.Since(diagnosticOrigin).Nanoseconds()
 out["context_error"]=fmt.Sprint(ctx.Err())
 if err:=diagnosticWrite("readback-"+label,out);err!=nil {t.Errorf("diagnostic readback export: %v",err)}
}
func diagnosticWrite(label string,value any) error {
 if strings.ContainsAny(label,"/\\") || label==".claude" {return fmt.Errorf("invalid artifact label")}
 dir:=os.Getenv("DECIDE_REPORT");if dir=="" {return fmt.Errorf("DECIDE_REPORT missing")}
 name:=filepath.Join(dir,fmt.Sprintf("%s-%s-%06d.json",label,diagnosticProcess,diagnosticSeq.Add(1)))
 data,err:=json.MarshalIndent(value,"","  ");if err!=nil{return err}
 if len(data)>4<<20{return fmt.Errorf("readback artifact cap exceeded")}
 if diagnosticArtifactCount.Add(1)>64{return fmt.Errorf("per-process artifact count cap exceeded")}
 return os.WriteFile(name,append(data,'\n'),0600)
}

# Scheduler adaptation: source is a reviewed tracked archive, never mutable HEAD.
# Python 3 is required by bootstrap-7-installsh-arch-probe and the receipt checker.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 \
 && rm -rf /var/lib/apt/lists/*

COPY source.tar.gz source-files.json source.sha256 SOURCE_COMMIT SOURCE_VERSION job-cases.json context-identity.json run-job.sh check-result.py /opt/b.w21/
RUN mkdir -p /work/source /work/tickets /opt/bin \
 && tar -xzf /opt/b.w21/source.tar.gz -C /work/source
WORKDIR /work/source
RUN sha256sum --quiet -c /opt/b.w21/source.sha256 \
 && make build COMMIT_SHA="$(cat /opt/b.w21/SOURCE_COMMIT)" AGENT_DIRECTOR_BUILD_VERSION="$(cat /opt/b.w21/SOURCE_VERSION)" \
 && cp bin/agent-director /usr/local/bin/agent-director \
 && cp bin/agent-director-admin /opt/bin/agent-director-admin \
 && cp -a test/driver /opt/driver \
 && cp -a skills /opt/skills \
 && cp -a test/install-mode /opt/install-mode \
 && cp -a tickets/testplans /work/tickets/testplans \
 && chmod 0755 bin/agent-director bin/agent-director-admin /usr/local/bin/agent-director /opt/bin/agent-director-admin /opt/b.w21/run-job.sh \
 && chmod -R 0755 /opt/driver /opt/skills \
 && chown -R tester:tester /opt/driver /opt/skills

USER tester
ENV HOME=/home/tester \
    PATH=/usr/local/bin:/usr/bin:/bin \
    AGENT_DIRECTOR_TEST_HARNESS=1
WORKDIR /home/tester
CMD ["/opt/b.w21/run-job.sh"]
